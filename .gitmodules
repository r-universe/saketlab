[submodule ".registry"]
	path = .registry
	url = https://github.com/saketlab/saketlab.r-universe.dev
	branch = HEAD
[submodule "anumaan"]
	path = anumaan
	url = https://github.com/saketlab/anumaan
[submodule "censusindia"]
	path = censusindia
	url = https://github.com/saketlab/censusindia
[submodule "genevintage"]
	path = genevintage
	url = https://github.com/saketlab/genevintage
	branch = main
	subdir = R
[submodule "lightson"]
	path = lightson
	url = https://github.com/saketlab/lightson
[submodule "seqout"]
	path = seqout
	url = https://github.com/saketlab/seqout
	branch = main
	subdir = R
[submodule "varunayan"]
	path = varunayan
	url = https://github.com/saketlab/varunayanR
[submodule "vayuayan"]
	path = vayuayan
	url = https://github.com/saketlab/vayuayanR
